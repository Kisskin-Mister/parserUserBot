# Telegram user account credentials from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=your_phone_number

# Pyrogram session name/path. With Docker this is stored in the telegram_session volume.
SESSION_NAME=session/my_account

# PostgreSQL. Docker Compose uses these to build the connection string.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=parseruserbot
POSTGRES_USER=parseruserbot
POSTGRES_PASSWORD=change_me

# Management API
APP_PORT=8000
ADMIN_TOKEN=token_here
# REST enqueue for Telegram user-account sends. Colon-separated on Linux; comma also accepted.
# Files outside these roots are rejected before enqueue.
TELEGRAM_ALLOWED_FILE_ROOTS=/app/resumes:/tmp

# Forwarding behavior: forward keeps Telegram attribution; copy sends plain text copy.
FORWARD_MODE=forward
IGNORE_PRIVATE_CHATS=true
# Comma-separated global deny-list. Useful for news channels or noisy chats.
EXCLUDED_CHAT_IDS=

# OpenAI-compatible classifier API for AI mode.
# For local models (LM Studio/Ollama/vLLM/llama.cpp server), use local base_url and OPENAI_API_KEY=local.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=local
OPENAI_MODEL=local-model

# Structured vacancy judge limits. Completed verdicts are cached in PostgreSQL.
AI_MAX_CALLS_PER_BATCH=20
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_INPUT_CHARS=50000

# PostgreSQL vacancy intake worker. Leave the ID empty to derive a unique host/process ID.
VACANCY_WORKER_ID=
VACANCY_WORKER_POLL_SECONDS=3
VACANCY_WORKER_LEASE_SECONDS=300

# Application inputs. Use container paths with Docker Compose. Multiple resume
# paths are separated by the platform path separator (`:` on Linux).
RESUME_ALLOWLIST=/app/resumes/resume.pdf

# Browser worker candidate profile (PII): create this ignored runtime file locally.
# It must contain only {"values": {...allowlisted keys...}, "allowed_resume_paths": [...]}.
BROWSER_CANDIDATE_PROFILE_PATH=/app/runtime/candidate-profile.json

# Optional Playwright worker. Keep final submission disabled for dry runs.
BROWSER_WORKER_ID=
BROWSER_POLL_SECONDS=5
BROWSER_LEASE_SECONDS=300
BROWSER_HEADLESS=true
BROWSER_MAX_PAGE_TEXT_CHARS=24000
BROWSER_ARTIFACTS_DIR=/app/runtime/browser_worker
BROWSER_USER_DATA_DIR=/app/runtime/browser_profiles
BROWSER_ALLOWED_DOMAINS=jobs.example.invalid,careers.example.invalid
BROWSER_FINAL_SUBMIT_ENABLED=false
# Required literal only when FINAL_SUBMIT_ENABLED is deliberately set true:
# BROWSER_FINAL_SUBMIT_ACK=SUBMIT_APPROVED_APPLICATIONS
BROWSER_FINAL_SUBMIT_ACK=

# Legacy compatibility options. New installs usually do not need these.
LOG_CHAT_ID=
OWNER_USERNAME=
NEWS_CHAT_ID=
# RESUME_PATH is supported for legacy code; prefer RESUME_ALLOWLIST above.
RESUME_PATH=
